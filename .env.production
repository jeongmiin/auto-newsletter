# 배포 환경 (vite build) — Git에 커밋된다.
# ⚠ 비밀값 금지: VITE_ 값은 번들에 박혀 배포본을 열면 누구나 본다. 키는 서버 시크릿에만.

# 업로드 API. 배포본엔 vite 프록시가 없어 브라우저가 직접 부른다 —
# 서버가 우리 오리진에 Access-Control-Allow-Origin 을 내려 줘야 한다
# (허용: newsletter.messeesang.com · jeongmiin.github.io). 사내망 전용 서버는 쓸 수 없다.
VITE_S3_UPLOAD_URL=https://fms.esfair.kr/api/files/s3upload

# 업로드 응답이 전체 URL 대신 키·파일명만 줄 때 앞에 붙일 주소. 이미지가 안 뜨면 채운다.
# VITE_S3_PUBLIC_BASE=https://esang-newsletter.s3.ap-northeast-2.amazonaws.com

# 번역 프록시(Cloudflare Worker) 주소 — 비우면 배포본의 번역 도구가 잠긴다.
# ⚠ Azure 키는 Worker 시크릿에만. 배포는 `npm run deploy:translate`.
VITE_AZURE_TRANSLATE_URL=https://auto-newsletter-translate.newsletter-builder.workers.dev/api/translate
