# 이 파일을 .env.local 로 복사해 실제 값을 채운다. .env.local 은 Git에 올라가지 않는다.
# VITE_ 가 없는 **서버 쪽** 변수라 브라우저 번들에는 들어가지 않는다
# (`npm run proxy:translate` 가 읽는다. 배포본은 Worker 시크릿 — docs/azure-translator.md).

AZURE_TRANSLATOR_KEY=여기에_Azure_KEY_1_입력

# Global 리소스로 만들었다면 비워 둔다.
AZURE_TRANSLATOR_REGION=

# 프록시가 받아 줄 출처. 여러 개면 쉼표로 구분한다.
TRANSLATE_ALLOWED_ORIGINS=http://localhost:5173

# 업로드를 목 서버로 돌리려면 여기에 VITE_S3_UPLOAD_URL=/api/files/s3upload 를 더한다.
