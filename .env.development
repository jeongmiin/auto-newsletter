# 개발 환경 (vite dev / preview) — Git에 커밋된다.
# ⚠ 비밀값 금지: VITE_ 값은 번들에 박혀 누구나 본다. 키는 .env.local 이나 서버 시크릿에.
# 개인 설정은 .env.local 로 덮어쓴다.

# 업로드 API. 절대 주소면 브라우저가 직접 부르고, 상대 경로면 vite 프록시를 탄다
# (목 서버로 시험 → vite.config.ts 의 uploadProxy 참고).
VITE_S3_UPLOAD_URL=https://fms.esfair.kr/api/files/s3upload

# 상대 경로 → vite 프록시. Azure 키는 프록시 서버 쪽에만 둔다.
VITE_AZURE_TRANSLATE_URL=/api/translate
