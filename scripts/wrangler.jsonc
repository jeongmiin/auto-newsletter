// Cloudflare Worker 설정 — 번역 프록시(azure-translate-worker.mjs).
// 사용법은 docs/azure-translator.md '운영 배포' 절. 비밀값(AZURE_TRANSLATOR_KEY)은 여기 넣지 않고
// `npx wrangler secret put AZURE_TRANSLATOR_KEY --config scripts/wrangler.jsonc` 로 등록한다.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "auto-newsletter-translate",
  "main": "azure-translate-worker.mjs",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // 공개 주소: https://auto-newsletter-translate.newsletter-builder.workers.dev (계정 서브도메인 newsletter-builder)
  "workers_dev": true,
  // 버전별 미리보기 주소는 쓰지 않는다 — 같은 Worker가 다른 주소로도 열리는 걸 막는다
  "preview_urls": false,
  "vars": {
    // Translator 리소스를 만든 지역. Global로 만들었으면 빈 문자열.
    "AZURE_TRANSLATOR_REGION": "koreacentral",
    // 이 Worker를 부를 수 있는 사이트 — 로컬 개발, GitHub Pages(루트·/develop 모두 같은 출처), 운영 도메인.
    // 출처는 프로토콜+도메인까지만 적는다(경로 없음).
    "TRANSLATE_ALLOWED_ORIGINS": "http://localhost:5173,https://jeongmiin.github.io,https://newsletter.messeesang.com"
  }
}
